{
  "run_name": "haloscope_local_sample_unit_rockstar_nbody",
  "paths": {
    "sim_hlist": "output/local_sample/unitsim/hlist_1.00000.list",
    "fastpm_list": "output/local_sample/fastpm/rockstar_out_nbody/out_8.list",
    "repo_root": ".",
    "output_dir": "output/local_sample_haloscope_run"
  },
  "sample": {
    "box_size_mpc_h": 200,
    "max_sim_halos": 20000,
    "max_fastpm_halos": 50000,
    "max_descriptor_batch_files": null
  },
  "haloscope": {
    "input_features": ["t_over_u", "tidal_anisotropy"],
    "min_bin_size": 5,
    "run_holdout_validation": true,
    "enriched_parquet_name": "fastpm_rockstar_nbody_haloscope_tidal_enriched.parquet"
  },
  "tidal": {
    "n_grid": 512,
    "unit_descriptors_dir": null,
    "fastpm_descriptors_dir": null
  },
  "validation": {
    "assembly_bias": {
      "enabled": false,
      "n_grid": 128
    }
  },
  "pipeline": {
    "tidal_anisotropy": {
      "enabled": true,
      "targets": ["unit", "fastpm"],
      "mass_particle": 1.2e9,
      "descriptor_batch_size": 50000,
      "unit": {
        "dm_particles_file": "output/local_sample/unitsim/dm_particles_0.5_128.dat",
        "work_dir": "output/local_sample_haloscope_run/unit",
        "catalog_layout": "hlist"
      },
      "fastpm": {
        "dm_particles_file": "output/local_sample/fastpm/snap_1.0000/1",
        "work_dir": "output/local_sample_haloscope_run/fastpm",
        "catalog_layout": "rockstar_list"
      }
    },
    "preprocess": {
      "enabled": true,
      "hr_parquet_name": "hr_preprocessed.parquet",
      "lr_parquet_name": "lr_preprocessed.parquet"
    },
    "haloscope": {
      "enabled": true
    }
  },
  "collect_tables": false
}
